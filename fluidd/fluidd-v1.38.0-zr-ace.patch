+import { describe, expect, it } from 'vitest'
+import { zrParseChain, zrToolChangeStage } from './zr'
+
+describe('zrParseChain', () => {
+  it('reads an ordered list', () => expect(zrParseChain('2,1', 0)).toEqual([2, 1]))
+  it('drops the head itself, repeats and out-of-range values', () => expect(zrParseChain('0,2,2,7,x, 3', 0)).toEqual([2, 3]))
+  it('handles empty and missing values', () => {
+    expect(zrParseChain('', 1)).toEqual([])
+    expect(zrParseChain(undefined, 1)).toEqual([])
+  })
+})
+
+describe('zrToolChangeStage', () => {
+  const start = [false, false, true, false]
+  it('starts at the beginning', () => {
+    expect(zrToolChangeStage({ from: 0, to: 2, start }, [false, false, true, false]).pct).toBe(10)
+  })
+  it('sees the old head put back', () => {
+    expect(zrToolChangeStage({ from: 0, to: 2, start }, [true, false, true, false]).pct).toBe(45)
+  })
+  it('sees the new head taken', () => {
+    expect(zrToolChangeStage({ from: 0, to: 2, start }, [true, false, false, false]).pct).toBe(80)
+  })
+  it('works for the first pick-up (no head on the carriage)', () => {
+    expect(zrToolChangeStage({ from: -1, to: 2, start }, [false, false, true, false]).pct).toBe(10)
+  })
+  it('ignores unknown sensors', () => {
+    expect(zrToolChangeStage({ from: 0, to: 1, start: [null, null, null, null] }, [true, true, true, true]).pct).toBe(10)
+  })
+})
