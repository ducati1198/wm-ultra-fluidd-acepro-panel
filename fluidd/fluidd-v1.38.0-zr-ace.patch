+// The touchscreen board uploads its status into the config folder every 60 s (wm-chamber-light-http, installer 2.11.0
+// and newer): version, newest version on GitHub, CPU, free memory. Read from Moonraker, so it also works when the
+// browser cannot reach the board itself (another network, a tunnel). Older than 3 minutes = the board stopped sending.
+const BOARD_FILE = 'config/wm_screen_status.json'
+const BOARD_STALE_S = 180
+
+interface ZrBoardStatus {
+  time: number
+  version: string | null
+  latest: string | null
+  cpu: number | null
+  screen_cpu: number | null
+  mem_free_mb: number
+  uptime_s: number
+  klipperscreen: string
+}
+
+/** True when a is an older dotted version than b (2.9.0 < 2.10.0). */
+function versionOlder (a: string, b: string): boolean {
+  const pa = a.split('.').map(n => parseInt(n, 10) || 0)
+  const pb = b.split('.').map(n => parseInt(n, 10) || 0)
+  for (let i = 0; i < Math.max(pa.length, pb.length); i++) {
+    if ((pa[i] ?? 0) !== (pb[i] ?? 0)) return (pa[i] ?? 0) < (pb[i] ?? 0)
+  }
+  return false
+}
 
