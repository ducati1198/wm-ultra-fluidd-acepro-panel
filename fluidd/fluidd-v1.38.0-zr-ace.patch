@@ -241,3 +241,29 @@ export const fileColoursFromTail = (tail: string): ZrFileColour[] => {
   if (types) meta.filament_type = types[1]
   return fileColoursFromMetadata(meta)
 }
+
+/** "2,1" (save_variable wm_endless_chain<N>) -> [2, 1]; drops the head itself, repeats and anything outside 0-3. */
+export const zrParseChain = (value: unknown, head: number): number[] => {
+  const out: number[] = []
+  for (const part of String(value ?? '').split(',')) {
+    const n = Number(part.trim())
+    if (part.trim() !== '' && Number.isInteger(n) && n >= 0 && n < ZR_HEADS && n !== head && !out.includes(n)) out.push(n)
+  }
+  return out
+}
+
+export interface ZrToolChange { from: number, to: number, start: Array<boolean | null> }
+
+/**
+ * Where a tool change is, from the dock sensors only (no WonderMaker macro is touched).
+ * `start` is the dock sensor state when the change began; a flip of the old head's sensor means it was
+ * put back, a flip of the new head's sensor means it was taken.
+ */
+export const zrToolChangeStage = (change: ZrToolChange, now: Array<boolean | null>): { pct: number, text: string } => {
+  const flipped = (i: number) => i >= 0 && i < ZR_HEADS && change.start[i] != null && now[i] != null && change.start[i] !== now[i]
+  const from = change.from >= 0 ? `Toolhead ${change.from + 1}` : 'the carriage'
+  const to = `Toolhead ${change.to + 1}`
+  if (flipped(change.to)) return { pct: 80, text: `Locking ${to}` }
+  if (change.from >= 0 && flipped(change.from)) return { pct: 45, text: `Putting ${from} back` }
+  return { pct: 10, text: `Changing to ${to}: lifting Z and moving to the dock` }
+}
