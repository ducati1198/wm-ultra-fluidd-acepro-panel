+    return { actual: Math.round(Number(c.temperature ?? 0)), target: Math.round(Number(c.target ?? 0)) }
+  }
+
+  get hasAirFilter () {
+    return this.zrPrinter['fan_generic air_fan'] != null
+  }
+
+  get airFilterOn () {
+    return Number(this.zrPrinter['fan_generic air_fan']?.speed ?? 0) > 0
+  }
+
+  get doorsText () {
+    const states = ['gcode_button Door_button1', 'gcode_button Door_button2']
+      .map(name => this.zrPrinter[name]?.state as string | undefined)
+      .filter(s => s != null)
+    if (states.length === 0) return '—'
+    return states.every(s => s === DOOR_CLOSED_STATE) ? 'CLOSED' : 'OPEN'
+  }
+
+  isPrintingHead (head: ZrHead) {
+    return head.onCarriage && this.zrPrintState === 'printing'
+  }
+
+  status (head: ZrHead) {
+    if (head.loaded === false) return { text: 'EMPTY', color: 'warning' }
+    if (this.isPrintingHead(head)) return { text: 'PRINTING', color: 'warning' }
+    if (head.onCarriage) return { text: 'ACTIVE', color: 'primary' }
+    if (head.loaded == null) return { text: 'UNKNOWN', color: 'secondary' }
+    return { text: 'READY', color: 'success' }
+  }
