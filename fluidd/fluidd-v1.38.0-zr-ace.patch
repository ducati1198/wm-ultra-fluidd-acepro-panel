+import { describe, expect, it, vi } from 'vitest'
+import { actions } from '@/store/console/actions'
+
+// "action:prompt_image name [name ...]": pictures in a prompt window (zr)
+const run = (message: string) => {
+  const commit = vi.fn()
+  const handler = actions.onUpdatePromptDialog as unknown as (ctx: { commit: typeof commit }, payload: unknown) => Promise<void>
+
+  handler({ commit }, { id: 7, type: 'action', message })
+
+  return commit
+}
+
+describe('prompt_image', () => {
+  it('adds one item with the picture names', () => {
+    const commit = run('// action:prompt_image setter-height setter-place setter-compare')
+
+    expect(commit).toHaveBeenCalledWith('setPromptDialogItem', {
+      type: 'image',
+      id: 7,
+      names: ['setter-height', 'setter-place', 'setter-compare']
+    })
+  })
+
+  it('drops anything that is not a plain name', () => {
