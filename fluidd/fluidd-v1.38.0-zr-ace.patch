+  border: 1px solid rgba(255, 255, 255, 0.3);
+  cursor: pointer;
+
+  &:focus-visible {
+    outline: 2px solid var(--v-primary-base);
+    outline-offset: 2px;
+  }
+}
+
+.zr-palette-btn--selected {
+  border: 3px solid var(--v-primary-base);
+}
+
+.zr-actions {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 8px;
+}
+</style>
