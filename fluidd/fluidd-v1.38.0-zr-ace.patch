new file mode 100644
index 0000000..6022c94
--- /dev/null
+++ b/src/components/widgets/zr/zrUi.ts
@@ -0,0 +1,79 @@
+const MAP_PRESETS_KEY = 'fluidd-zr-map-presets'
+const MAP_FILE_PREFIX = 'fluidd-zr-map-file:'
+
+const readStorage = (key: string): string | null => {
+  try {
+    return window.localStorage.getItem(key)
+  } catch {
+    return null
+  }
+}
+
+const writeStorage = (key: string, value: string) => {
+  try {
+    window.localStorage.setItem(key, value)
+  } catch {
+    // storage can be blocked; the window just forgets the choice
+  }
+}
+
+/** Mapping of file filament (row) to toolhead index. */
+export type ZrRowMap = Record<number, number>
+
+export interface ZrSavedMapping {
+  name: string
+  map: ZrRowMap
+}
+
+export interface ZrDryPreset { label: string, temp: number, minutes: number }
+
+// Same presets as the dryer in the Toolheads card. The ACE heater tops out at 65 °C.
+const DRY_PRESETS: Array<ZrDryPreset & { materials: string[] }> = [
+  { label: 'PLA', temp: 45, minutes: 240, materials: ['PLA'] },
+  { label: 'PETG', temp: 55, minutes: 360, materials: ['PETG', 'PET'] },
+  { label: 'ABS / ASA', temp: 65, minutes: 360, materials: ['ABS', 'ASA', 'HIPS'] },
+  { label: 'TPU', temp: 50, minutes: 360, materials: ['TPU', 'TPE'] },
+  { label: 'Nylon (PA)', temp: 65, minutes: 480, materials: ['PA', 'NYLON'] },
+  { label: 'PVA', temp: 45, minutes: 360, materials: ['PVA'] }
+]
+
+export const zrDryPresetFor = (material: string | undefined): ZrDryPreset | undefined => {
+  const key = (material ?? '').toUpperCase().trim().split(/[\s_-]+/)[0]
+  const found = DRY_PRESETS.find(p => p.materials.includes(key))
+  return found ? { label: found.label, temp: found.temp, minutes: found.minutes } : undefined
+}
+
+export const zrFormatMinutes = (minutes: number): string => {
+  if (minutes < 60) return `${minutes} min`
+  const hours = Math.floor(minutes / 60)
+  const rest = minutes % 60
+  return rest === 0 ? `${hours} h` : `${hours} h ${rest} min`
+}
+
+export const loadZrMapPresets = (): ZrSavedMapping[] => {
+  try {
+    const parsed: unknown = JSON.parse(readStorage(MAP_PRESETS_KEY) ?? '[]')
+    return Array.isArray(parsed)
+      ? parsed.filter((item): item is ZrSavedMapping => item != null && typeof item.name === 'string' && typeof item.map === 'object')
+      : []
+  } catch {
+    return []
+  }
+}
+
+export const saveZrMapPresets = (presets: ZrSavedMapping[]) => {
+  writeStorage(MAP_PRESETS_KEY, JSON.stringify(presets))
+}
+
+export const loadZrFileMapping = (filename: string): ZrRowMap | undefined => {
+  try {
+    const parsed: unknown = JSON.parse(readStorage(MAP_FILE_PREFIX + filename) ?? 'null')
+    return parsed != null && typeof parsed === 'object' ? parsed as ZrRowMap : undefined
+  } catch {
+    return undefined
+  }
+}
+
+export const saveZrFileMapping = (filename: string, map: ZrRowMap) => {
+  writeStorage(MAP_FILE_PREFIX + filename, JSON.stringify(map))
+}
