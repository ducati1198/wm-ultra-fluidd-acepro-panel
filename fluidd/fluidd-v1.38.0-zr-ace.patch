+    this.zrSend('SET_GCODE_VARIABLE MACRO=_WM_PURGE_SEL VARIABLE=open VALUE=1')
+  }
+
+  get sharedOpen () {
+    const v = this.zrPrinter['gcode_macro _WM_PURGE_SEL']?.open
+    return v == null ? null : Number(v)
+  }
+
+  @Watch('sharedOpen')
+  onSharedOpen (v: number | null) {
+    if (v === 1) this.seenOpen = true
+    // closed (and wiped, cooled, parked) from the touchscreen or the prompt window: close this one too
+    if (v === 0 && this.seenOpen) {
+      this.purged = false
+      this.open = false
+    }
+  }
+
+  get ownTemp () {
+    return this.zrSavedTemp(this.tool) || 210
+  }
+
+  get blocked () {
+    return !this.klippyReady || this.zrBusy
+  }
+
+  get blockedText () {
+    return this.zrBusy ? 'Purging is not possible while a print runs or is paused.' : 'The printer is not ready.'
+  }
+
+  start () {
+    // FINISH=2: the toolhead stays hot at the purge location, so more can be purged; Cancel finishes it (_WM_PURGE_DONE)
+    this.zrSend(`_WM_PURGE T=${this.tool} S=${this.temp} SPEED=${this.speed} LEN=${this.length} FINISH=2`)
+    EventBus.$emit(`Purging toolhead ${this.tool + 1}: ${this.length} mm at ${this.speed} mm/s`, { timeout: 4000 })
+    this.purged = true
+    this.purgedTool = this.tool
+  }
+
+  finish () {
+    // always: _WM_PURGE_DONE closes the purge window on the touchscreen too, and wipes, cools and parks when a tool is hot
+    this.zrSend('_WM_PURGE_DONE')
+    if (this.purged) {
+      EventBus.$emit('Wiping, cooling and parking the toolhead', { timeout: 4000 })
+    }
+    this.purged = false
+    this.open = false
+  }
+}
