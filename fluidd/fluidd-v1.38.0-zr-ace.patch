+  display: inline-block;
+}
+
+.zr-palette {
+  display: grid;
+  grid-template-columns: repeat(7, 1fr);
+  gap: 6px;
+}
+
+.zr-palette-btn {
+  aspect-ratio: 1;
+  min-height: 36px;
