+  async loadBoard () {
+    try {
+      const response = await this.serverFilesGet<string>(BOARD_FILE, { responseType: 'text', transformResponse: [(d: unknown) => d] })
+      const parsed: unknown = JSON.parse(String(response.data ?? '{}'))
+      if (parsed == null || typeof parsed !== 'object' || !('time' in parsed) || typeof parsed.time !== 'number') return
+      const st = parsed as ZrBoardStatus
+      const age = Date.now() / 1000 - st.time
+      this.board = age > BOARD_STALE_S
+        ? { status: null, error: `no news since ${new Date(st.time * 1000).toLocaleTimeString()} (board off or offline?)` }
